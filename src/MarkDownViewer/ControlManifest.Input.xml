<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="MDViewerPCF" constructor="MarkDownViewer" version="1.3.0" display-name-key="MarkdownViewer" description-key="MarkDownViewer_Desc" control-type="standard">
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <property name="Content" display-name-key="Content" description-key="Content_Desc" of-type="Multiple" usage="bound" required="true"/>
    <property name="FontSize" display-name-key="Size" description-key="Size_Desc" of-type="Whole.None" usage="bound" required="true"/>
    <property name="Font" display-name-key="Font" description-key="Font_Desc" of-type="Enum" usage="bound" required="true">
      <value name="Arial" display-name-key="Arial" description-key="Arial_Desc">Arial</value>
      <value name="Courier_New" display-name-key="CourierNew" description-key="CourierNew_Desc">Courier New</value>
      <value name="Dancing_Script" display-name-key="DancingScript" description-key="DancingScript_Desc">Dancing Script</value>
      <value name="Georgia" display-name-key="Georgia" description-key="Georgia_Desc">Georgia</value>
      <value name="Great_Vibes" display-name-key="GreatVibes" description-key="GreatVibes_Desc">Great Vibes</value>
      <value name="Lato" display-name-key="Lato" description-key="Lato_Desc">Lato</value>
      <value name="Lato_Black" display-name-key="LatoBlack" description-key="LatoBlack_Desc">Lato Black</value>
      <value name="Lato_Hairline" display-name-key="LatoHairline" description-key="LatoHairline_Desc">Lato Hairline</value>
      <value name="Lato_Light" display-name-key="LatoLight" description-key="LatoLight_Desc">Lato Light</value>
      <value name="Open_Sans" display-name-key="OpenSans" description-key="OpenSans_Desc">Open Sans</value>
      <value name="Open_Sans_Condensed" display-name-key="OpenSansCondensed" description-key="OpenSansCondensed_Desc">Open Sans Condensed</value>
      <value name="Patrick_Hand" display-name-key="PatrickHand" description-key="PatrickHand_Desc">Patrick Hand</value>
      <value name="Segoe_UI" display-name-key="SegoeUI" description-key="SegoeUI_Desc">Segoe UI</value>
      <value name="Verdana" display-name-key="Verdana" description-key="Verdana_Desc">Verdana</value>
      <value name="Custom" display-name-key="Custom" description-key="Custom_Desc">custom</value>
    </property>

    <property name="FontColor" display-name-key="FontColor" description-key="FontColor_Desc" of-type="SingleLine.Text" usage="bound" required="false" />
    <property name="Fill" display-name-key="Fill" description-key="Fill_Desc" of-type="SingleLine.Text" usage="bound" required="false" />

    <property name="Overflow" display-name-key="Overflow" description-key="Overflow_Desc" of-type="Enum" usage="bound" required="true">
      <value name="None" display-name-key="None" description-key="None_Desc">none</value>
      <value name="Auto" display-name-key="Auto" description-key="Auto_Desc">auto</value>
      <value name="Scroll" display-name-key="Scroll" description-key="Scroll_Desc">scroll</value>
    </property>

    <property name="ContentWidth" display-name-key="ContentWidth"  required="false" of-type="Decimal" usage="output" />
    <property name="ContentHeight" display-name-key="ContentHeight" required="false" of-type="Decimal" usage="output" />
    <property name="ContentAsHtml" display-name-key="ContentAsHtml" required="false" of-type="Multiple" usage="output" />

    <resources>
      <code path="index.ts" order="1"/>
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="css/MarkDownViewer.css" order="1" />
      <resx path="strings/MarkDownViewer.1033.resx" version="1.0.0" />
      -->
    </resources>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>